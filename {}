  ],
  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "The `Max()` method returns the largest numeric element from a collection."
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Max Examples",
        "content": "Finding maximum values in collections",
        "language": "csharp",
        "code": "IList<int> intList = new List<int>() { 10, 21, 30, 45, 50, 87 };\n\nvar largest = intList.Max();\n// Result: 87\n\nvar largestEvenElements = intList.Max(i => {\n    if (i % 2 == 0)\n        return i;\n    return 0;\n});\n// Result: 50"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Max with Complex Types",
        "content": "Finding maximum of properties",
        "language": "csharp",
        "code": "IList<Student> studentList = new List<Student>() {\n    new Student() { StudentID = 1, StudentName = \"John\", Age = 13 },\n    new Student() { StudentID = 2, StudentName = \"Moin\", Age = 21 },\n    new Student() { StudentID = 3, StudentName = \"Bill\", Age = 18 },\n    new Student() { StudentID = 4, StudentName = \"Ram\", Age = 20 },\n    new Student() { StudentID = 5, StudentName = \"Ron\", Age = 15 }\n};\n\nvar oldest = studentList.Max(s => s.Age);\n// Result: 21"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Max with Custom Comparison"
      }
    },
    {
      "type": "paragraph",
      "data": {
