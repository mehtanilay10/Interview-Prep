generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressCategory {
  lessons
  problems
  interviewQuestions
}

enum BookmarkType {
  lesson
  problem
  interview
  cheatsheet
}

enum UserTheme {
  light
  dark
  system
}

model User {
  id              String                @id @db.Text
  email           String                @unique @db.Text
  name            String?               @db.Text
  image           String?               @db.Text
  createdAt       DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)
  progress        UserProgress[]
  bookmarks       UserBookmark[]
  lastPath        UserLastPath?
  themePreference UserThemePreference?
  lessonNotes     UserLessonNote[]
  offlineQueue    OfflineReadingQueue[]

  @@map("users")
}

model UserProgress {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Text
  category    ProgressCategory
  lessonSlug  String           @map("lesson_slug") @db.Text
  moduleSlug  String           @map("module_slug") @db.Text
  completedAt DateTime         @default(now()) @map("completed_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, lessonSlug])
  @@index([userId])
  @@map("user_progress")
}

model UserBookmark {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Text
  type       BookmarkType
  slug       String       @db.Text
  title      String       @db.Text
  courseSlug String       @map("course_slug") @db.Text
  moduleSlug String       @map("module_slug") @db.Text
  addedAt    DateTime     @default(now()) @map("added_at") @db.Timestamptz(6)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, slug])
  @@index([userId])
  @@map("user_bookmarks")
}

model UserLastPath {
  userId    String   @id @map("user_id") @db.Text
  path      String   @db.Text
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_last_path")
}

model UserThemePreference {
  userId    String    @id @map("user_id") @db.Text
  theme     UserTheme
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_theme_preferences")
}

model UserLessonNote {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Text
  courseSlug String   @map("course_slug") @db.Text
  moduleSlug String   @map("module_slug") @db.Text
  lessonSlug String   @map("lesson_slug") @db.Text
  content    String   @default("") @db.Text
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug, lessonSlug])
  @@index([userId])
  @@map("user_lesson_notes")
}

model OfflineReadingQueue {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Text
  courseSlug String   @map("course_slug") @db.Text
  moduleSlug String   @map("module_slug") @db.Text
  lessonSlug String   @map("lesson_slug") @db.Text
  title      String   @db.Text
  queuedAt   DateTime @default(now()) @map("queued_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, moduleSlug, lessonSlug])
  @@index([userId])
  @@map("offline_reading_queue")
}
