    },
    {
      "type": "paragraph",
      "data": {
        "text": "Merge two sorted linked lists and return the merged list."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 1: Iterative with Dummy"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n+m) O(1)",
        "language": "csharp",
        "code": "public ListNode? MergeTwoLists(ListNode? a, ListNode? b)\n{\n    ListNode dummy = new ListNode(0);\n    ListNode tail = dummy;\n    while (a != null && b != null)\n    {\n        if (a.Val <= b.Val) { tail.Next = a; a = a.Next; }\n        else { tail.Next = b; b = b.Next; }\n        tail = tail.Next;\n    }\n    tail.Next = a ?? b;\n    return dummy.Next;\n}"
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Approach 2: Recursive"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "O(n+m) O(n+m)",
        "language": "csharp",
        "code": "public ListNode? MergeTwoListsRec(ListNode? a, ListNode? b)\n{\n    if (a == null) return b;\n    if (b == null) return a;\n    if (a.Val <= b.Val) { a.Next = MergeTwoListsRec(a.Next, b); return a; }\n    b.Next = MergeTwoListsRec(a, b.Next);\n    return b;\n}"
      }
    },
