      "type": "heading",
      "data": {
        "level": 2,
        "text": "LINQ Learning Path"
      }
    },
    {
      "type": "mermaid",
      "data": {
        "id": "linq-learning-roadmap",
        "caption": "LINQ learning path from basics to advanced concepts",
        "definition": "graph LR\n    A[Basics] --> B[Query Syntax]\n    A --> C[Method Syntax]\n    A --> D[Lambda Expressions]\n    B --> E[Filtering]\n    C --> E\n    D --> E\n    E --> F[Sorting]\n    F --> G[Grouping]\n    G --> H[Joining]\n    H --> I[Aggregation]\n    I --> J[Set Operations]\n    J --> K[Advanced Concepts]"
