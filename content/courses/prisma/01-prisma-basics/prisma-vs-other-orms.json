  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Choosing an ORM depends on your team, stack, and requirements. Prisma sits between raw SQL and heavier ORMs like TypeORM, offering type safety without excessive ceremony."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Comparison Table"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "ORM",
          "Type Safety",
          "Schema Definition",
          "Migration Approach",
          "Best For"
        ],
        "rows": [
          [
            "Prisma",
            "Excellent",
            "schema.prisma",
            "Declarative migrations",
            "TypeScript-first apps, Next.js"
          ],
          [
            "TypeORM",
            "Good",
            "Decorators / schema",
            "Query-based migrations",
            "Enterprise apps, decorators"
          ],
          [
            "Sequelize",
            "Fair",
            "Model definitions",
            "Query-based migrations",
            "Legacy projects, JS-heavy teams"
          ],
          [
            "Drizzle",
            "Excellent",
            "Code-first",
            "SQL-based migrations",
            "Edge runtimes, minimalism"
          ]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "When to Choose Prisma"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "You want full TypeScript type safety without manual type definitions",
          "You prefer a declarative schema over code-first models",
          "You need a visual database editor (Prisma Studio)",
          "You are building a Next.js or React full-stack application"
        ]
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "info",
        "title": "Note",
        "text": "Prisma is not the only great choice. Drizzle is excellent for edge runtimes and minimal bundle sizes, while raw SQL is still the best choice for complex analytical queries."
      }
    }
  ],
