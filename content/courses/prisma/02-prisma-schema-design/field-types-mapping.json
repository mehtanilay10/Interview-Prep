{
  "id": "lesson-prisma-007",
  "slug": "field-types-mapping",
  "moduleSlug": "prisma-schema-design",
  "courseSlug": "prisma",
  "title": "Field Types Mapping to PostgreSQL",
  "description": "Learn how Prisma field types map to PostgreSQL types and when to use native database types.",
  "order": 2,
  "difficulty": "beginner",
  "estimatedMinutes": 10,
  "tags": [
    "prisma",
    "postgresql",
    "field-types",
    "native-types"
  ],
  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Prisma provides a set of scalar types that map to native PostgreSQL types. Understanding these mappings helps you choose the right type for each field and avoid data loss or truncation."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Common Type Mappings"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "Prisma Type",
          "PostgreSQL Type",
          "Notes"
        ],
        "rows": [
          [
            "String",
            "text / varchar",
            "Use `@db.VarChar(n)` for varchar"
          ],
          [
            "Int",
            "integer",
            "32-bit signed integer"
          ],
          [
            "BigInt",
            "bigint",
            "64-bit signed integer"
          ],
          [
            "Float",
            "double precision",
            "64-bit floating point"
          ],
          [
            "Decimal",
            "decimal",
            "Exact precision; use `@db.Decimal(p, s)`"
          ],
          [
            "Boolean",
            "boolean",
            "true / false"
          ],
          [
            "DateTime",
            "timestamp",
            "Use `@db.Timestamp` for precise control"
          ],
          [
            "Json",
            "jsonb",
            "Binary JSON; supports indexing"
          ],
          [
            "Bytes",
            "bytea",
            "Binary data"
          ]
        ]
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Using Native Database Types"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "When you need PostgreSQL-specific types not covered by Prisma scalars, use the `@db` attribute to map directly to a native type."
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Native Type Mapping",
        "content": "Map Prisma types to native PostgreSQL types.",
        "code": "model Product {\n  id          Int      @id @default(autoincrement())\n  sku         String   @db.VarChar(50)\n  price       Decimal  @db.Decimal(10, 2)\n  metadata    Json\n  createdAt   DateTime @default(now()) @db.Timestamp\n}",
        "language": "prisma"
      }
    }
  ],
  "relatedLessons": [
