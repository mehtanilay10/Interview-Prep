      "type": "paragraph",
      "data": {
        "text": "A PRIMARY KEY uniquely identifies each row. It creates a unique B-tree index."
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Primary Key",
        "content": "Create table with primary key",
        "language": "sql",
        "code": "CREATE TABLE users (\n  id BIGSERIAL PRIMARY KEY,\n  email CITEXT NOT NULL UNIQUE\n);"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "tip",
        "title": "Tip",
        "text": "Prefer BIGSERIAL for surrogate keys and use UNIQUE for business keys."
      }
    },
