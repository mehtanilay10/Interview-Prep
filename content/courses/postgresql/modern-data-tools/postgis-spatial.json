        "title": "Spatial",
        "content": "Create spatial table",
        "language": "sql",
        "code": "CREATE EXTENSION IF NOT EXISTS postgis;\n\nCREATE TABLE places (\n  id BIGSERIAL PRIMARY KEY,\n  name TEXT NOT NULL,\n  location GEOGRAPHY(Point, 4326)\n);\n\nINSERT INTO places (name, location)\nVALUES ('Office', ST_MakePoint(-73.935242, 40.730610)::GEOGRAPHY);"
      }
