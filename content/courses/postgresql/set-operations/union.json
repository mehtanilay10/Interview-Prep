        "text": "UNION"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "UNION combines result sets and removes duplicates. UNION ALL keeps duplicates."
      }
    },
    {
      "type": "example",
      "data": {
        "title": "UNION",
        "content": "Combine active and archived users",
        "language": "sql",
        "code": "SELECT id, email FROM active_users\nUNION\nSELECT id, email FROM archived_users\nORDER BY 2\nLIMIT 200;"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "tip",
        "title": "Performance",
        "text": "UNION ALL is faster because it does not deduplicate."
      }
    },
    {
      "type": "exercise",
      "data": {
        "title": "Exercise: Merge Active Lists",
        "description": "Combine active and VIP users.",
        "steps": [
          "Use UNION or UNION ALL",
          "Deduplicate if needed",
          "Order by email"
        ],
        "expectedOutcome": "Combined result set."
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "UNION removes duplicates.",
          "Use UNION ALL when duplicates are acceptable.",
          "Use ORDER BY at the end."
        ]
      }
    }
