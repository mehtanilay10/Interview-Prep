      "data": {
        "title": "pg_dump",
        "content": "Back up database",
        "language": "bash",
        "code": "pg_dump -U postgres -F c -b -v -f appdb.dump appdb"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "pg_restore",
        "content": "Restore database",
        "language": "bash",
        "code": "pg_restore -U postgres -d appdb_restore -v appdb.dump"
      }
    },
