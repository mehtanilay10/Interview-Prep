        "title": "Encrypt",
        "content": "Encrypt and decrypt column",
        "language": "sql",
        "code": "CREATE EXTENSION IF NOT EXISTS pgcrypto;\n\nINSERT INTO sensitive_data (ssn, encrypted_ssn)\nVALUES ('123-45-6789', pgp_sym_encrypt('123-45-6789', 'secret_key'));\n\nSELECT pgp_sym_decrypt(encrypted_ssn, 'secret_key') AS ssn\nFROM sensitive_data;"
      }
