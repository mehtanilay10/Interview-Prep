      }
    },
    {
      "type": "example",
      "data": {
        "title": "RLS",
        "content": "Enable RLS and create policy",
        "language": "sql",
        "code": "ALTER TABLE users ENABLE ROW LEVEL SECURITY;\n\nCREATE POLICY user_isolation ON users\n  FOR ALL\n  TO app_user\n  USING (id = current_setting('app.current_user_id')::INT);"
      }
    },
