      "data": {
        "title": "Group By",
        "content": "Count orders per user",
        "language": "sql",
        "code": "SELECT user_id, COUNT(*) AS order_count, SUM(total) AS lifetime\nFROM orders\nWHERE created_at >= CURRENT_DATE - INTERVAL '1 year'\nGROUP BY user_id\nHAVING COUNT(*) > $1\nORDER BY lifetime DESC\nLIMIT 100;"
      }
    },
