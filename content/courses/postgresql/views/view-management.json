      "data": {
        "text": "Use CREATE OR REPLACE VIEW to update definitions. Use ALTER VIEW for column security."
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Replace View",
        "content": "Replace view definition",
        "language": "sql",
        "code": "CREATE OR REPLACE VIEW user_stats AS\nSELECT user_id, COUNT(*) AS order_count, SUM(total) AS lifetime\nFROM orders\nWHERE status <> 'canceled'\nGROUP BY user_id;"
      }
