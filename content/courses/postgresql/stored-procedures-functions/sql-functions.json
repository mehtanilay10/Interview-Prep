        "content": "Create immutable SQL function",
        "language": "sql",
        "code": "CREATE OR REPLACE FUNCTION discount_price(p_price NUMERIC, p_rate NUMERIC)\nRETURNS NUMERIC\nLANGUAGE SQL\nIMMUTABLE\nAS $$ SELECT p_price * (1 - p_rate); $$;"
      }
