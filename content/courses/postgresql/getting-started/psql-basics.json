    {
      "type": "paragraph",
      "data": {
        "text": "psql is the standard command-line client for PostgreSQL. It supports meta-commands starting with backslash."
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "Command",
          "Description"
        ],
        "rows": [
          [
            "\\\\l",
            "List databases"
          ],
          [
            "\\\\c dbname",
            "Connect to database"
          ],
          [
            "\\\\dt",
            "List tables"
          ],
          [
            "\\\\d tablename",
            "Describe table"
          ],
          [
            "\\\\dn",
            "List schemas"
          ],
          [
            "\\\\dx",
            "List extensions"
          ],
          [
            "\\\\g",
            "Execute query"
          ],
          [
            "\\\\q",
            "Quit"
          ]
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "psql Scripting",
        "content": "Run SQL from a file",
        "language": "bash",
        "code": "psql -U postgres -f schema.sql -d appdb"
      }
    },
