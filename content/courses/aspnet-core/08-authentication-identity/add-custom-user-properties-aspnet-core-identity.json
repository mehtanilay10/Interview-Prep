    {
      "type": "paragraph",
      "data": {
        "text": "Finally, update the Create and Update actions of the Admin controller as shown in highlighted manner below."
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Create Action"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`public` `async` `TaskIActionResult Create(User user)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(ModelState.IsValid)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`AppUser appUser =` `new` `AppUser`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`UserName = user.Name,`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Email = user.Email,`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Country = user.Country,`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Age = user.Age,`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Salary = user.Salary`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`};`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`IdentityResult result =` `await` `userManager.CreateAsync(appUser, user.Password);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(result.Succeeded)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`return` `RedirectToAction(``\"Index\"``);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`else`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`foreach` `(IdentityError error` `in` `result.Errors)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`ModelState.AddModelError(``\"\"``, error.Description);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`}`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`}`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`return` `View(user);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "There is just one change where we are adding the new custom properties values to the AppUser class object:"
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Code Example",
        "content": "Code example for How to add Custom User Properties in ASP.NET Core Identity",
        "language": "csharp",
        "code": "Country = user.Country,\nAge = user.Age,\nSalary = user.Salary"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Update Action"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`public` `async` `TaskIActionResult Update(``string` `id,` `string` `email,` `string` `password,` `int` `age,` `string` `country,` `string` `salary)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`AppUser user =` `await` `userManager.FindByIdAsync(id);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(user !=` `null``)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(!``string``.IsNullOrEmpty(email))`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`user.Email = email;`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`else`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`ModelState.AddModelError(``\"\"``,` `\"Email cannot be empty\"``);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(!``string``.IsNullOrEmpty(password))`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`user.PasswordHash = passwordHasher.HashPassword(user, password);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`else`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`ModelState.AddModelError(``\"\"``,` `\"Password cannot be empty\"``);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`user.Age = age;`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Country myCountry;`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Enum.TryParse(country,` `out` `myCountry);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`user.Country = myCountry;`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(!``string``.IsNullOrEmpty(salary))`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`user.Salary = salary;`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`else`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`ModelState.AddModelError(``\"\"``,` `\"Salary cannot be empty\"``);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(!``string``.IsNullOrEmpty(email) && !``string``.IsNullOrEmpty(password) && !``string``.IsNullOrEmpty(salary))`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`{`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`IdentityResult result =` `await` `userManager.UpdateAsync(user);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`if` `(result.Succeeded)`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`return` `RedirectToAction(``\"Index\"``);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`else`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`Errors(result);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`}`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`}`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`else`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`ModelState.AddModelError(``\"\"``,` `\"User Not Found\"``);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "`return` `View(user);`"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "The changes which we have done to this action are:"
