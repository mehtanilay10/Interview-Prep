      "type": "heading",
      "data": {
        "level": 2,
        "text": "Common Middleware"
      }
    },
    {
      "type": "bullet-list",
      "data": {
        "items": [
          "**UseHttpsRedirection**: Redirect HTTP to HTTPS",
          "**UseCORS**: Enable Cross-Origin Resource Sharing",
          "**UseAuthentication**: Authenticate users",
          "**UseAuthorization**: Authorize access",
          "**UseStaticFiles**: Serve static files",
          "**UseExceptionHandler**: Handle errors"
        ]
      }
    },
    {
      "type": "example",
      "data": {
        "title": "CORS",
        "content": "Configuring CORS",
        "language": "csharp",
        "code": "builder.Services.AddCors(options =>\n{\n    options.AddPolicy(\"AllowReactApp\",\n        policy => policy\n            .WithOrigins(\"http://localhost:3000\")\n            .AllowAnyHeader()\n            .AllowAnyMethod());\n});\n\napp.UseCors(\"AllowReactApp\");"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "tip",
        "title": "CORS for React",
        "text": "When your React app runs on a different port, you must enable CORS in your API."
      }
    },
