      "type": "paragraph",
      "data": {
        "text": "**Model binding** automatically maps request data to action method parameters. It can bind from the route, query string, request body, and headers."
      }
    },
    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "Binding Sources"
      }
    },
    {
      "type": "table",
      "data": {
        "headers": [
          "Attribute",
          "Source"
        ],
        "rows": [
          [
            "[FromRoute]",
            "URL route parameters"
          ],
          [
            "[FromQuery]",
            "Query string parameters"
          ],
          [
            "[FromBody]",
            "Request body (JSON)"
          ],
          [
            "[FromHeader]",
            "HTTP headers"
          ],
          [
            "[FromForm]",
            "Form data"
          ]
        ]
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "tip",
        "title": "Default Behavior",
        "text": "Complex types default to [FromBody]. Simple types default to [FromQuery]. Use attributes to override."
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "Model binding maps request data",
          "Multiple binding sources",
          "Attributes specify source",
          "Reduces manual parsing"
        ],
        "takeaway": "Model binding simplifies parameter handling."
