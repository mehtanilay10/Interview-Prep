    "moduleSlug":  "data-types",
    "title":  "CHAR Data Type",
    "description":  "Learn how to use the CHAR data type to store fixed-length, non-Unicode character strings.",
    "order":  2,
    "difficulty":  "beginner",
    "estimatedMinutes":  8,
    "tags":  [
                 "char",
                 "data-type",
                 "string"
             ],
    "blocks":  [
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "SQL Server CHAR Data Type"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "The CHAR data type stores fixed-length, non-Unicode character strings. Use CHAR when the sizes of values in the column are fixed."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "CHAR Syntax"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "CHAR Syntax",
                                    "content":  "Defines a CHAR column with a specified length.",
                                    "language":  "sql",
                                    "code":  "CHAR(n)"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "n specifies the string length from 1 to 8,000. If not specified, the default value is 1."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "CHAR Example"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Create CHAR Column",
                                    "content":  "Creates a table with a CHAR(3) column.",
                                    "language":  "sql",
                                    "code":  "CREATE TABLE test.sql_server_char (\n    val CHAR(3)\n);"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "When you insert a string shorter than the defined length, SQL Server adds trailing spaces. When you select the value, SQL Server removes the trailing spaces."
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Insert and Query CHAR Value",
                                    "content":  "Inserts a 3-character string and queries it.",
                                    "language":  "sql",
                                    "code":  "INSERT INTO test.sql_server_char (val)\nVALUES (\u0027ABC\u0027);\n\nSELECT\n    val,\n    LEN(val) len,\n    DATALENGTH(val) data_length\nFROM\n    sql_server_char;"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "Even though the character \u0027A\u0027 is only one character, the number of bytes is fixed at three. LEN returns the number of characters excluding trailing blanks, while DATALENGTH returns the number of bytes."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "CHAR vs. VARCHAR"
                                }
                   },
                   {
                       "type":  "bullet-list",
                       "data":  {
                                    "items":  [
                                                  "CHAR is fixed-length; VARCHAR is variable-length.",
                                                  "CHAR pads values with trailing spaces; VARCHAR does not.",
                                                  "Use CHAR when data sizes are consistent; use VARCHAR when sizes vary."
                                              ]
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "CHAR Key Points",
                                    "points":  [
                                                   "CHAR stores fixed-length, non-Unicode character strings.",
                                                   "Length ranges from 1 to 8,000 characters.",
                                                   "Trailing spaces are added for shorter values and removed on select.",
                                                   "Use CHAR when data sizes are consistent across rows.",
                                                   "ISO synonym: CHARACTER."
                                               ]
                                }
                   }
               ]
}
