                   {
                       "type":  "callout",
                       "data":  {
                                    "variant":  "warning",
                                    "title":  "Note",
                                    "text":  "SQL Server will remove ntext, text, and image data types in future versions. Use nvarchar(max), varchar(max), and varbinary(max) instead."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "Data Types Overview Key Points",
                                    "points":  [
                                                   "SQL Server provides exact numeric, approximate numeric, date/time, character, Unicode, binary, and other data types.",
                                                   "Use the smallest integer type that can reliably contain all possible values.",
                                                   "For new applications, prefer datetime2, date, time, and datetimeoffset over datetime.",
                                                   "Avoid ntext, text, and image — use their max variants instead."
                                               ]
                                }
                   }
