             ],
    "blocks":  [
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "SQL Server DECIMAL Data Type"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "The DECIMAL data type stores exact numeric values with fixed precision and scale. Use DECIMAL for monetary values or any data requiring exact arithmetic."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "DECIMAL Syntax"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "DECIMAL Syntax",
                                    "content":  "Defines a DECIMAL column with precision and scale.",
                                    "language":  "sql",
                                    "code":  "DECIMAL(p,s)"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "p is the precision (maximum total decimal digits, 1-38, default 38). s is the scale (decimal digits to the right of the decimal point, 0 to p). DECIMAL and NUMERIC are synonyms."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Storage Size by Precision"
                                }
                   },
                   {
                       "type":  "table",
                       "data":  {
                                    "headers":  [
                                                    "Precision",
                                                    "Storage Bytes"
                                                ],
                                    "rows":  [
                                                 [
                                                     "1 – 9",
                                                     "5"
                                                 ],
                                                 [
                                                     "10-19",
                                                     "9"
                                                 ],
                                                 [
                                                     "20-28",
                                                     "13"
                                                 ],
                                                 [
                                                     "29-38",
                                                     "17"
                                                 ]
                                             ]
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "DECIMAL Example"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Create DECIMAL Column",
                                    "content":  "Creates a table with DECIMAL and NUMERIC columns.",
                                    "language":  "sql",
                                    "code":  "CREATE TABLE test.sql_server_decimal (\n    dec_col DECIMAL (4, 2),\n    num_col NUMERIC (4, 2)\n);"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Insert DECIMAL Values",
                                    "content":  "Inserts valid and invalid DECIMAL values.",
                                    "language":  "sql",
                                    "code":  "INSERT INTO test.sql_server_decimal (dec_col, num_col)\nVALUES (10.05, 20.05);\n\nINSERT INTO test.sql_server_decimal (dec_col, num_col)\nVALUES (99.999, 12.345);"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "The second insert fails with an arithmetic overflow error because the values exceed the precision and scale."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "DECIMAL Key Points",
                                    "points":  [
                                                   "DECIMAL stores exact numeric values with fixed precision and scale.",
                                                   "DECIMAL and NUMERIC are synonyms.",
                                                   "Precision ranges from 1 to 38.",
                                                   "Scale ranges from 0 to the precision value.",
                                                   "Storage size depends on the precision (5 to 17 bytes).",
                                                   "Use DECIMAL for monetary or exact arithmetic values."
                                               ]
                                }
                   }
               ]
}
