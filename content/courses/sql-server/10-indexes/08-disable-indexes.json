             ],
    "blocks":  [
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "SQL Server Disable Indexes"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "To disable an index, you use the ALTER INDEX statement with the DISABLE keyword. Disabling an index makes it ineffective for query optimization."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "DISABLE Syntax"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Disable a single index",
                                    "content":  "Disables a specific index on a table.",
                                    "language":  "sql",
                                    "code":  "ALTER INDEX index_name\nON table_name\nDISABLE;"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Disable all indexes on a table",
                                    "content":  "Disables all indexes on the specified table.",
                                    "language":  "sql",
                                    "code":  "ALTER INDEX ALL ON table_name\nDISABLE;"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Effects of Disabling an Index"
                                }
                   },
                   {
                       "type":  "bullet-list",
                       "data":  {
                                    "items":  [
                                                  "The query optimizer will not consider the disabled index for query plans.",
                                                  "If you disable a clustered index, you cannot access the table data using SELECT, INSERT, UPDATE, or DELETE until the index is rebuilt or dropped.",
                                                  "SQL Server keeps the index definition in metadata and statistics for nonclustered indexes."
                                              ]
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "Disable Index Key Points",
                                    "points":  [
                                                   "Use ALTER INDEX ... DISABLE to make an index ineffective.",
                                                   "Disabling a clustered index blocks all data access to the table.",
                                                   "Disabling indexes is useful during bulk data loads to avoid index maintenance overhead.",
                                                   "You must rebuild or drop a disabled index to re-enable it."
                                               ]
                                }
                   }
               ]
}
