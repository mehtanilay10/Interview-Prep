{
    "id":  "lesson-sql-093",
    "slug":  "enable-indexes",
    "moduleSlug":  "indexes",
    "title":  "Enable Indexes",
    "description":  "Learn how to rebuild and re-enable disabled indexes using ALTER INDEX, CREATE INDEX, and DBCC DBREINDEX.",
    "order":  9,
    "difficulty":  "beginner",
    "estimatedMinutes":  10,
    "tags":  [
                 "enable-index",
                 "rebuild-index",
                 "alter-index"
             ],
    "blocks":  [
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "SQL Server Enable Indexes"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "After disabling an index (e.g., before a bulk update), you need to rebuild it to re-enable it. You cannot simply enable a disabled index — it must be rebuilt."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Enable Using ALTER INDEX"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Rebuild a single index",
                                    "content":  "Rebuilds a disabled index to make it usable again.",
                                    "language":  "sql",
                                    "code":  "ALTER INDEX index_name\nON table_name\nREBUILD;"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Rebuild all disabled indexes",
                                    "content":  "Rebuilds all disabled indexes on the table.",
                                    "language":  "sql",
                                    "code":  "ALTER INDEX ALL ON table_name\nREBUILD;"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Enable Using CREATE INDEX"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Recreate index with DROP_EXISTING",
                                    "content":  "Recreates the index, replacing the disabled one.",
                                    "language":  "sql",
                                    "code":  "CREATE INDEX index_name\nON table_name(column_list)\nWITH(DROP_EXISTING=ON);"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Enable Using DBCC DBREINDEX"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "DBCC DBREINDEX syntax",
                                    "content":  "Rebuilds an index using the legacy DBCC DBREINDEX command.",
                                    "language":  "sql",
                                    "code":  "DBCC DBREINDEX (table_name, index_name);"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "Enable Index Key Points",
                                    "points":  [
                                                   "Disabled indexes must be rebuilt, not simply enabled.",
                                                   "Use ALTER INDEX ... REBUILD for the standard approach.",
                                                   "CREATE INDEX WITH (DROP_EXISTING=ON) can also rebuild a disabled index.",
                                                   "DBCC DBREINDEX is a legacy command still available for compatibility."
                                               ]
                                }
                   }
               ]
}
