    "blocks":  [
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "SQL Server CASE Expression"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "The CASE expression evaluates a list of conditions and returns one of the multiple specified results. It has two formats: simple CASE and searched CASE."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Simple CASE Syntax"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Simple CASE expression",
                                    "content":  "Maps order status codes to readable labels.",
                                    "language":  "sql",
                                    "code":  "CASE order_status\n    WHEN 1 THEN \u0027Pending\u0027\n    WHEN 2 THEN \u0027Processing\u0027\n    WHEN 3 THEN \u0027Rejected\u0027\n    WHEN 4 THEN \u0027Completed\u0027\nEND AS order_status"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Searched CASE Syntax"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Searched CASE expression",
                                    "content":  "Classifies orders by value range.",
                                    "language":  "sql",
                                    "code":  "CASE\n    WHEN SUM(quantity * list_price) \u003c= 500 THEN \u0027Very Low\u0027\n    WHEN SUM(quantity * list_price) \u003c= 1000 THEN \u0027Low\u0027\n    WHEN SUM(quantity * list_price) \u003c= 5000 THEN \u0027Medium\u0027\n    WHEN SUM(quantity * list_price) \u003c= 10000 THEN \u0027High\u0027\n    ELSE \u0027Very High\u0027\nEND AS order_priority"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "CASE Expression Key Points",
                                    "points":  [
                                                   "CASE is an expression usable in SELECT, WHERE, GROUP BY, and HAVING.",
                                                   "Simple CASE compares for equality; searched CASE evaluates Boolean expressions.",
                                                   "The ELSE clause is optional and returns NULL if omitted.",
                                                   "CASE expressions can be nested inside aggregate functions."
                                               ]
                                }
                   }
               ]
}
