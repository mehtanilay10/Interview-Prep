                                    "text":  "SQL Server List All Triggers"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "To list all triggers in a SQL Server database, query the sys.triggers system view."
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "List all triggers using sys.triggers",
                                    "content":  "Returns trigger names and whether they are INSTEAD OF triggers.",
                                    "language":  "sql",
                                    "code":  "SELECT\n    name,\n    is_instead_of_trigger\nFROM\n    sys.triggers\nWHERE\n    type = \u0027TR\u0027;"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "List Triggers Key Points",
                                    "points":  [
                                                   "Use sys.triggers to list all triggers in the database.",
                                                   "The is_instead_of_trigger column indicates if a trigger is an INSTEAD OF trigger.",
                                                   "Filter by type = \u0027TR\u0027 to return only triggers (not other objects).",
                                                   "You can also use sys.objects with type = \u0027TR\u0027 as an alternative."
                                               ]
                                }
                   }
               ]
}
