    "blocks":  [
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "SQL Server Full Backup"
                                }
                   },
                   {
                       "type":  "paragraph",
                       "data":  {
                                    "text":  "A full database backup backs up the entire database including metadata and all used data pages. It is the foundation for all other backup types."
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "BACKUP DATABASE Syntax"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Create a full backup",
                                    "content":  "Backs up the HR database to a file.",
                                    "language":  "sql",
                                    "code":  "BACKUP DATABASE database_name\nTO DISK = path_to_backup_file\nWITH options;"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Full backup with INIT",
                                    "content":  "Creates a full backup, overwriting any existing backup file.",
                                    "language":  "sql",
                                    "code":  "BACKUP DATABASE HR\nTO DISK = \u0027D:\\backup\\hr.bak\u0027\nWITH INIT,\nNAME = \u0027HR-Full Database Backup\u0027;"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Restore from Full Backup"
                                }
                   },
                   {
                       "type":  "example",
                       "data":  {
                                    "title":  "Restore database from full backup",
                                    "content":  "Restores the HR database from a backup file.",
                                    "language":  "sql",
                                    "code":  "RESTORE DATABASE HR\nFROM DISK = N\u0027D:\\backup\\hr.bak\u0027\nWITH FILE = 1;"
                                }
                   },
                   {
                       "type":  "heading",
                       "data":  {
                                    "level":  2,
                                    "text":  "Key Takeaways"
                                }
                   },
                   {
                       "type":  "summary-box",
                       "data":  {
                                    "title":  "Full Backup Key Points",
                                    "points":  [
                                                   "Use BACKUP DATABASE to create a full backup.",
                                                   "Use WITH INIT to overwrite and WITH NOINIT to append.",
                                                   "Use RESTORE DATABASE to restore from a full backup.",
                                                   "A full backup is the baseline for differential and log backups."
                                               ]
                                }
                   }
               ]
}
