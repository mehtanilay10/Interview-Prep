      "type": "paragraph",
      "data": {
        "text": "Framer Motion is a production-ready motion library for React. It provides gestures, layout animations, and exit animations."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "jsx",
        "caption": "Framer Motion animation",
        "code": "import { motion, AnimatePresence } from \"framer-motion\";\n\n<motion.div\n  animate={{ scale: 1, opacity: 1 }}\n  initial={{ scale: 0, opacity: 0 }}\n  transition={{ duration: 0.3 }}\n>\n  Content\n</motion.div>"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Gesture",
            "definition": "User interaction like drag and tap."
          },
          {
            "term": "Layout animation",
            "definition": "Animation when layout changes."
          },
          {
            "term": "Exit animation",
            "definition": "Animation when component unmounts."
          }
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "items": [
          {
            "text": "Framer Motion is the standard for React animations."
          },
          {
            "text": "Declarative API with powerful variants."
          },
          {
            "text": "Supports gestures and layout animations."
          }
        ]
      }
