      "type": "paragraph",
      "data": {
        "text": "Popmotion is a low-level animation library that powers Framer Motion. It provides tweening, springs, and keyframes."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "javascript",
        "caption": "Popmotion tween",
        "code": "import { tween, styler } from \"popmotion\";\n\nconst styler = styler(document.querySelector(\".box\"));\ntween({ from: 0, to: 100, duration: 300 }).start(v =>\n  styler.set({ x: v })\n);"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Styler",
            "definition": "Animates DOM or style properties."
          },
          {
            "term": "Tween",
            "definition": "Interpolates values over time."
          }
        ]
      }
    },
    {
      "type": "summary-box",
