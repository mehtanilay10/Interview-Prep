    {
      "type": "paragraph",
      "data": {
        "text": "CSS Modules compile class names to unique identifiers, achieving scoping without CSS-in-JS runtime overhead."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "css",
        "caption": "Button.module.css",
        "code": ".button {\n  background: blue;\n  color: white;\n}\n\n.button:hover {\n  background: darkblue;\n}"
      }
    },
    {
      "type": "example",
      "data": {
        "language": "jsx",
        "caption": "Importing CSS Modules",
        "code": "import styles from \"./Button.module.css\";\n\n<button className={styles.button}>Save</button>"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "CSS Module",
            "definition": "CSS file with locally scoped class names."
          },
          {
            "term": "Hashing",
            "definition": "Generating unique class names."
          }
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "items": [
          {
            "text": "CSS Modules scope styles by default."
          },
          {
            "text": "No runtime overhead compared to CSS-in-JS."
          },
