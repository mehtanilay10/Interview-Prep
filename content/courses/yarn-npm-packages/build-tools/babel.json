    {
      "type": "paragraph",
      "data": {
        "text": "Babel compiles modern JavaScript and TypeScript into backwards-compatible versions. It powers many build pipelines."
      }
    },
    {
      "type": "heading",
      "data": {
        "text": "Presets and Plugins",
        "level": "h2"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "Babel uses presets (pre-configured plugin sets) and plugins (individual transformations). The @babel/preset-env preset automatically targets supported browsers."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "javascript",
        "caption": "babel.config.json",
        "code": "{\n  \"presets\": [\n    [\"@babel/preset-env\", { \"targets\": \"> 0.25%, not dead\" }],\n    \"@babel/preset-typescript\"\n  ],\n  \"plugins\": [\"@babel/plugin-proposal-class-properties\"]\n}"
      }
    },
