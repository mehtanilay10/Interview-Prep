  "blocks": [
    {
      "type": "paragraph",
      "data": {
        "text": "Immer lets you write mutative code that produces immutable updates. It uses proxies to track changes and produce a new state."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "javascript",
        "caption": "Immer produce",
        "code": "import { produce } from \"immer\";\n\nconst nextState = produce(state, draft => {\n  draft.items.push({ id: 3, name: \"New\" });\n});\n\nconsole.log(nextState.items);\nconsole.log(state.items); // unchanged"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Proxy",
            "definition": "Object wrapper that intercepts operations."
          },
          {
            "term": "Draft",
            "definition": "Mutable working copy."
          }
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "items": [
          {
            "text": "Immer makes immutable updates simple."
          },
          {
            "text": "Used in Redux Toolkit."
          },
          {
            "text": "Reduces bugs from accidental mutation."
          }
        ]
      }
    }
  ],
