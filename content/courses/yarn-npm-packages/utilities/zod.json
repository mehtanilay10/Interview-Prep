    {
      "type": "paragraph",
      "data": {
        "text": "Zod lets you define schemas that validate unknown data and infer TypeScript types automatically."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "typescript",
        "caption": "Zod schema",
        "code": "import { z } from \"zod\";\n\nconst UserSchema = z.object({\n  name: z.string(),\n  age: z.number().min(0)\n});\n\ntype User = z.infer<typeof UserSchema>;\n\nconst result = UserSchema.safeParse({ name: \"Alice\", age: 30 });"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Schema",
            "definition": "Shape and rules for data."
          },
          {
            "term": "Inference",
            "definition": "Deriving types from schemas."
          },
          {
            "term": "Safe parse",
            "definition": "Returns result without throwing."
          }
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "items": [
          {
            "text": "Zod eliminates manual type definitions."
          },
          {
            "text": "Great for API validation."
          },
          {
            "text": "Composable and extensible."
          }
        ]
      }
    }
  ]
