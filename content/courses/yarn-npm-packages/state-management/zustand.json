      "type": "paragraph",
      "data": {
        "text": "Zustand is a minimal state management solution using hooks. It requires no boilerplate providers or reducers."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "javascript",
        "caption": "Zustand store",
        "code": "import create from \"zustand\";\n\nconst useStore = create(set => ({\n  bears: 0,\n  increase: () => set(state => ({ bears: state.bears + 1 }))\n}));"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Hook",
            "definition": "React function to use state."
          },
          {
            "term": "Store",
            "definition": "Global state container."
          }
        ]
      }
    },
