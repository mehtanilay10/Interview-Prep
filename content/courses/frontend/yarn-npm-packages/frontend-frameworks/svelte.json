      "type": "paragraph",
      "data": {
        "text": "Svelte is a compiler-based framework. It shifts work from runtime to build time, producing highly optimized vanilla JavaScript."
      }
    },
    {
      "type": "heading",
      "data": {
        "text": "Svelte vs Traditional Frameworks",
        "level": "h2"
      }
    },
    {
      "type": "comparison-cards",
      "data": {
        "items": [
          {
            "title": "Svelte",
            "description": "Compiler approach. No virtual DOM. Smaller bundles."
          },
          {
            "title": "React/Vue",
            "description": "Runtime approach. Virtual DOM. Larger runtime overhead."
          }
        ]
      }
    },
    {
      "type": "example",
      "data": {
