      "data": {
        "text": "Storybook is an open-source tool for developing UI components in isolation. It supports addons for documentation, accessibility, and testing."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "javascript",
        "caption": "Storybook story",
        "code": "import Button from \"./Button\";\n\nexport default {\n  title: \"Example/Button\",\n  component: Button\n};\n\nexport const Primary = {\n  args: { primary: true, label: \"Primary\" }\n};"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Story",
            "definition": "A single state of a component."
          },
          {
            "term": "Addon",
            "definition": "Extension that adds functionality."
          }
        ]
      }
    },
    {
