    {
      "type": "heading",
      "data": {
        "level": 2,
        "text": "What is NuGet.Config?"
      }
    },
    {
      "type": "paragraph",
      "data": {
        "text": "NuGet.Config is an XML configuration file that controls package source locations, credentials, and restore behavior. It can be placed at the solution, user, or machine level."
      }
    },
    {
      "type": "example",
      "data": {
        "title": "Example NuGet.Config",
        "content": "Configure multiple package sources.",
        "language": "xml",
        "code": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<configuration>\n  <packageSources>\n    <add key=\"nuget.org\" value=\"https://api.nuget.org/v3/index.json\" />\n    <add key=\"MyPrivateFeed\" value=\"https://pkgs.dev.azure.com/org/_packaging/feed/nuget/v3/index.json\" />\n  </packageSources>\n</configuration>"
      }
    },
    {
      "type": "callout",
      "data": {
        "variant": "tip",
        "title": "Tip",
        "text": "Use `dotnet nuget list source` to see configured package sources."
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "points": [
          "NuGet.Config controls package sources",
          "Supports multiple feeds",
          "Can be scoped to solution or user"
        ],
        "takeaway": "Use NuGet.Config to manage private and public package feeds."
      }
    }
  ],
