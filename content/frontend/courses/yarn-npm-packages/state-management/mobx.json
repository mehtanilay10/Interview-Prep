      "type": "paragraph",
      "data": {
        "text": "MobX uses observables and reactions to manage state. Any observable change triggers automatic UI updates."
      }
    },
    {
      "type": "example",
      "data": {
        "language": "javascript",
        "caption": "MobX observable state",
        "code": "import { makeObservable, observable, action } from \"mobx\";\n\nclass Store {\n  count = 0;\n  constructor() { makeObservable(this); }\n  increment = action(() => { this.count++; });\n}"
      }
    },
    {
      "type": "key-terms",
      "data": {
        "terms": [
          {
            "term": "Observable",
            "definition": "State that MobX tracks."
          },
          {
            "term": "Reaction",
            "definition": "Side effect triggered by state changes."
          }
        ]
      }
    },
    {
      "type": "summary-box",
      "data": {
        "title": "Key Takeaways",
        "items": [
